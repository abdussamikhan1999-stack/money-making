# Kite Connect app credentials — create an app at https://developers.kite.trade/apps
# (paid subscription, currently ~Rs 500/month, billed to your Zerodha account)
KITE_API_KEY=
KITE_API_SECRET=

# Kite access tokens expire daily (~7:30am IST). Regenerate each trading day:
#   1. Visit the URL printed by `python -c "from kite_client import login_url; print(login_url())"`
#   2. Log in, get redirected to your app's redirect URL with ?request_token=...
#   3. python -c "from kite_client import generate_access_token; print(generate_access_token('PASTE_REQUEST_TOKEN'))"
#   4. Paste the printed token below.
KITE_ACCESS_TOKEN=

# Refuse to place real orders unless this is explicitly "true" (see run_live.py --live).
MONEYMAKING_LIVE=false
